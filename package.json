{
    "name": "template",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "concertypin",
        "url": "https://github.com/concertypin"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "check": "pnpm run format && pnpm run lint && pnpm run typecheck",
        "typecheck": "svelte-check --tsconfig ./tsconfig.app.json --tsgo-experimental-api",
        "format": "prettier --write . --cache --list-different",
        "lint": "pnpm run lint:oxlint --fix && pnpm run lint:eslint --fix",
        "lint:check": "pnpm run lint:oxlint && pnpm run lint:eslint",
        "lint:oxlint": "oxlint .",
        "lint:eslint": "eslint . --cache --cache-location node_modules/.cache/eslint",
        "postinstall": "pnpm exec simple-git-hooks",
        "preview": "vite preview",
        "pre-commit": "pnpm run check && git add -u",
        "test": "vitest run"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "phosphor-svelte": "^3.1.0",
        "svelte": "^5.56.7",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^26.1.1",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.10",
        "cross-env": "^10.1.0",
        "daisyui": "^5.7.0",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-oxlint": "^1.73.0",
        "eslint-plugin-svelte": "^3.22.0",
        "globals": "^17.7.0",
        "oxlint": "^1.74.0",
        "oxlint-tsgolint": "^0.25.0",
        "playwright": "^1.61.1",
        "postcss": "^8.5.20",
        "prettier": "^3.9.6",
        "simple-git-hooks": "^2.13.1",
        "svelte-check": "^4.7.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5",
        "vitest": "^4.1.10",
        "vitest-browser-svelte": "^3.0.0"
    },
    "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
