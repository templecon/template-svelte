{
    "name": "template",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "concertypin",
        "url": "https://github.com/concertypin"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "pnpm run lint:oxlint --fix && pnpm run lint:eslint --fix",
        "lint:check": "pnpm run lint:oxlint && pnpm run lint:eslint",
        "lint:oxlint": "oxlint . --type-aware --type-check --report-unused-disable-directives-severity=error",
        "lint:eslint": "eslint .",
        "postinstall": "pnpm exec simple-git-hooks",
        "preview": "vite preview",
        "check": "pnpm run format && pnpm run lint && pnpm run test",
        "test": "vitest run"
    },
    "engines": {
        "node": ">=26"
    },
    "dependencies": {
        "svelte": "^5.55.1",
        "svelte5-router": "^3.1.0",
        "tailwindcss": "^4.2.2"
    },
    "devDependencies": {
        "@concertypin/config": "^0.2.0",
        "@eslint/js": "^10.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/postcss": "^4.2.2",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^25.5.0",
        "@vitest/coverage-v8": "^4.1.2",
        "cross-env": "^10.1.0",
        "eslint": "^10.1.0",
        "eslint-plugin-svelte": "^3.16.0",
        "globals": "^17.4.0",
        "jsdom": "^30.0.1",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.58.0",
        "oxlint-tsgolint": "^7.0.2001",
        "postcss": "^8.5.8",
        "simple-git-hooks": "^2.13.1",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.58.0",
        "vite": "^8.0.3",
        "vitest": "^4.1.2"
    },
    "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
